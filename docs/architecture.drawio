        <mxCell id="lg5" value="┅ gris: fase 2 (no implementado)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7F8C8D;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1395" y="820" width="270" height="24" as="geometry"/></mxCell>
