  <diagram id="page6" name="μ3 · VPS en capas">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="860" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="μ3 · Una VPS en capas (defensa en profundidad)" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#232F3E;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="sub" value="MICRO · ¿Qué protege a la VPS app en cada capa, y qué pasa si una capa cae?" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1660" height="30" as="geometry"/></mxCell>
        <mxCell id="L1" value="1 · Nube (AWS)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#232F3E;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1070" height="690" as="geometry"/></mxCell>
        <mxCell id="L1t" value="SG por referencia · egress restringido · IMDSv2 (hop limit 1) · EBS cifrado · rol de instancia mínimo (SSM + S3) · IP pública solo para SSM y GHCR" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="1030" height="50" as="geometry"/></mxCell>
        <mxCell id="L2" value="2 · Sistema operativo (Ubuntu 26.04)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3FAF4;strokeColor=#1E8E3E;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#1E8E3E;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="1010" height="560" as="geometry"/></mxCell>
        <mxCell id="L2t" value="SSH desactivado · parches automáticos · auditd (identidad, sudo y Docker) · ufw · sysctl · chrony · Lynis 69 de 100" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="970" height="50" as="geometry"/></mxCell>
        <mxCell id="L3" value="3 · Docker" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#2088FF;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#2088FF;" vertex="1" parent="1"><mxGeometry x="90" y="320" width="950" height="430" as="geometry"/></mxCell>
        <mxCell id="L3t" value="daemon: no-new-privileges · live-restore · userland-proxy desactivado · rotación de logs" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="110" y="360" width="910" height="40" as="geometry"/></mxCell>
        <mxCell id="L4" value="4 · Contenedores (VPS app)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#ED7100;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="890" height="310" as="geometry"/></mxCell>
        <mxCell id="cApi" value="&lt;b&gt;API FastAPI&lt;/b&gt;&lt;br&gt;&lt;br&gt;usuario no root (uid 10001)&lt;br&gt;raíz en solo lectura + tmpfs&lt;br&gt;cap_drop ALL&lt;br&gt;no-new-privileges&lt;br&gt;256 MB y 100 procesos&lt;br&gt;healthcheck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="270" height="230" as="geometry"/></mxCell>
        <mxCell id="cFalco" value="&lt;b&gt;Falco 0.45.2&lt;/b&gt;&lt;br&gt;&lt;br&gt;sensor eBPF en el kernel&lt;br&gt;reglas con técnicas MITRE&lt;br&gt;privilegiado a propósito&lt;br&gt;vigila host y contenedores&lt;br&gt;&lt;br&gt;&lt;i&gt;Es el más privilegiado:&lt;br&gt;por eso está aislado aquí&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="270" height="230" as="geometry"/></mxCell>
        <mxCell id="cAlloy" value="&lt;b&gt;Alloy v1.21&lt;/b&gt;&lt;br&gt;&lt;br&gt;root sin capacidades&lt;br&gt;estado en tmpfs&lt;br&gt;lee docker.sock en solo lectura&lt;br&gt;etiqueta cada contenedor&lt;br&gt;envía los logs a Loki&lt;br&gt;&lt;br&gt;&lt;i&gt;Riesgo: docker.sock&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="720" y="470" width="270" height="230" as="geometry"/></mxCell>
        <mxCell id="tbl" value="&lt;b&gt;Cada capa asume que la anterior puede fallar&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr style='background:#EEF1F5'&gt;&lt;th&gt;Si falla…&lt;/th&gt;&lt;th&gt;Qué lo frena&lt;/th&gt;&lt;th&gt;Qué lo detecta&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Un SG queda abierto por error&lt;/td&gt;&lt;td&gt;CI: Checkov y Trivy sobre el IaC&lt;/td&gt;&lt;td&gt;Revisión del PR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cuenta del SO comprometida&lt;/td&gt;&lt;td&gt;Sin SSH, sin llaves, parches&lt;/td&gt;&lt;td&gt;auditd y Falco (host)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Escape del contenedor&lt;/td&gt;&lt;td&gt;no-new-privileges, sin capacidades&lt;/td&gt;&lt;td&gt;Falco (eBPF)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Fallo en el código de la API&lt;/td&gt;&lt;td&gt;Solo lectura, sin root, límites&lt;/td&gt;&lt;td&gt;Falco y errores 4xx/5xx&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Credenciales robadas del IMDS&lt;/td&gt;&lt;td&gt;IMDSv2 con hop limit 1&lt;/td&gt;&lt;td&gt;CloudTrail&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Principio:&lt;/b&gt; ningún control es perfecto; la combinación sí encarece el ataque y deja rastro." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1130" y="100" width="540" height="480" as="geometry"/></mxCell>
        <mxCell id="lg0" value="━ verde: tráfico de la aplicación" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E8E3E;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg1" value="━ naranja: logs y alertas" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#ED7100;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="295" y="820" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg2" value="┅ magenta: administración por SSM" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#E7157B;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="820" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg3" value="━ azul: CI/CD y registro" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#2088FF;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="845" y="820" width="270" height="24" as="geometry"/></mxCell>
