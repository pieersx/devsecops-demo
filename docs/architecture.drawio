        <mxCell id="o6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E7157B;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="eng" target="ssm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="o7" value="túnel SSM :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E7157B;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ssm" target="graf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1417" y="150"/><mxPoint x="1037" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="tDash" value="&lt;b&gt;Qué muestra el dashboard&lt;/b&gt;&lt;br&gt;• Alertas de Falco (solo líneas con priority)&lt;br&gt;• 🔴 Alertas dentro de contenedores: debe ser 0&lt;br&gt;• Errores de la API (4xx y 5xx): escáneres&lt;br&gt;• Peticiones reales a la API, sin health checks&lt;br&gt;• Alertas por regla y quién las dispara (proceso y padre)&lt;br&gt;• Logs de contenedor, de host y de peticiones&lt;br&gt;• Volumen de logs por contenedor" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="520" height="200" as="geometry"/></mxCell>
        <mxCell id="tTri" value="&lt;b&gt;Triage en 4 preguntas&lt;/b&gt;&lt;br&gt;1 · ¿Quién? usuario y proceso&lt;br&gt;2 · ¿Qué lo lanzó? el proceso padre (parent)&lt;br&gt;3 · ¿Cuándo? ¿coincide con una tarea nuestra?&lt;br&gt;4 · ¿Dónde? contenedor o host&lt;br&gt;&lt;br&gt;&lt;b&gt;Ejemplos reales:&lt;/b&gt;&lt;br&gt;cat con padre containerd-shim = docker exec dentro de un contenedor&lt;br&gt;grep con padre lynis = auditoría en el host" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="480" width="520" height="200" as="geometry"/></mxCell>
        <mxCell id="tGap" value="&lt;b&gt;Brechas conocidas&lt;/b&gt;&lt;br&gt;• Los logs de Caddy no llegan a Loki (Alloy solo corre en la VPS app)&lt;br&gt;• La API ve la IP del gateway, no la del cliente&lt;br&gt;• Alloy → Loki viaja en HTTP plano dentro de la VPC&lt;br&gt;• Las alertas son solo visuales: sin Slack ni correo&lt;br&gt;• Alloy y Falco necesitan privilegios o acceso a docker.sock&lt;br&gt;• Alloy guarda su estado en tmpfs y relee logs al reiniciar" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1160" y="480" width="500" height="200" as="geometry"/></mxCell>
        <mxCell id="lg0" value="━ verde: tráfico de la aplicación" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E8E3E;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg1" value="━ naranja: logs y alertas" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#ED7100;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="295" y="700" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg2" value="┅ magenta: administración por SSM" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#E7157B;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="700" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg3" value="━ azul: CI/CD y registro" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#2088FF;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="845" y="700" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg4" value="━ rojo: IAM, OIDC y bloqueos" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#DD344C;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="700" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg5" value="┅ gris: fase 2 (no implementado)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7F8C8D;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1395" y="700" width="270" height="24" as="geometry"/></mxCell>
