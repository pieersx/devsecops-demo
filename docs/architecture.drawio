        <mxCell id="e5" value="Session Manager (IAM + MFA, sin puerto 22)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E7157B;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="eng" target="ssm"><mxGeometry x="-0.3" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="Run Command y sesiones (agente SSM, 443 saliente)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E7157B;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ssm" target="ec2App"><mxGeometry x="-0.18" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E7157B;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ssm" target="ec2Gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="265"/><mxPoint x="475" y="265"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="túnel Grafana :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E7157B;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ssm" target="ec2Ops"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="265"/><mxPoint x="1095" y="265"/></Array></mxGeometry></mxCell>
        <mxCell id="tbl" value="&lt;b&gt;Matriz de flujos permitidos&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr style='background:#EEF1F5'&gt;&lt;th&gt;Origen&lt;/th&gt;&lt;th&gt;Destino&lt;/th&gt;&lt;th&gt;Puerto&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;gateway&lt;/td&gt;&lt;td&gt;80&lt;/td&gt;&lt;td nowrap&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;gateway&lt;/td&gt;&lt;td&gt;app&lt;/td&gt;&lt;td&gt;8000&lt;/td&gt;&lt;td nowrap&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;app&lt;/td&gt;&lt;td&gt;ops&lt;/td&gt;&lt;td&gt;3100&lt;/td&gt;&lt;td nowrap&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;VPS&lt;/td&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;443, 80, DNS&lt;/td&gt;&lt;td nowrap&gt;✅ salida&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;app y ops&lt;/td&gt;&lt;td&gt;cualquiera&lt;/td&gt;&lt;td nowrap&gt;❌&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cualquiera&lt;/td&gt;&lt;td&gt;cualquier VPS&lt;/td&gt;&lt;td&gt;22 (SSH)&lt;/td&gt;&lt;td nowrap&gt;❌ cerrado&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Cada regla es un recurso en &lt;b&gt;infra/main.tf&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1280" y="120" width="400" height="420" as="geometry"/></mxCell>
        <mxCell id="lg0" value="━ verde: tráfico de la aplicación" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E8E3E;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg1" value="━ naranja: logs y alertas" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#ED7100;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="295" y="940" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg2" value="┅ magenta: administración por SSM" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#E7157B;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="940" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg3" value="━ azul: CI/CD y registro" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#2088FF;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="845" y="940" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg4" value="━ rojo: IAM, OIDC y bloqueos" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#DD344C;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="940" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg5" value="┅ gris: fase 2 (no implementado)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7F8C8D;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1395" y="940" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="tDns" value="&lt;b&gt;DNS, TLS e IP pública&lt;/b&gt;&lt;br&gt;• DNS: resolver de la VPC (10.20.0.2); sin zona privada ni dominio público&lt;br&gt;• TLS: SSM, GHCR y GitHub van cifrados; cliente → Caddy y app → ops van en HTTP (pendiente)&lt;br&gt;• IP pública dinámica: cambia al parar y arrancar (sin Elastic IP)&lt;br&gt;• Egress DNS solo por UDP 53: el respaldo por TCP está bloqueado" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1280" y="570" width="400" height="230" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
