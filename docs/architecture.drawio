        <mxCell id="lg4" value="━ rojo: IAM, OIDC y bloqueos" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#DD344C;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="860" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg5" value="┅ gris: fase 2 (no implementado)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7F8C8D;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1395" y="860" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="t9" value="T9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="160" y="150" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="t10" value="T10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="175" y="548" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="tbl" value="&lt;b&gt;Amenazas, controles y dónde se implementan&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr style='background:#EEF1F5'&gt;&lt;th&gt;ID&lt;/th&gt;&lt;th&gt;Amenaza&lt;/th&gt;&lt;th&gt;Control&lt;/th&gt;&lt;th&gt;Estado&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Explotación de la API (inyección, ejecución remota)&lt;/td&gt;&lt;td&gt;Semgrep en cada PR; contenedor sin root, read-only, cap_drop ALL; Falco en runtime&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Secreto filtrado en git&lt;/td&gt;&lt;td&gt;Gitleaks en cada PR; sin llaves de AWS en GitHub (OIDC); SOPS u OpenBao para secretos de aplicación&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dependencia o imagen vulnerable o manipulada&lt;/td&gt;&lt;td&gt;Trivy (dependencias e imagen) falla el CI con HIGH/CRITICAL; SBOM; Cosign y verificación antes de desplegar; Dependabot&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Robo de credenciales de la nube&lt;/td&gt;&lt;td&gt;SSO con credenciales de 1 hora; OIDC para GitHub; pendiente: retirar la llave estática del usuario admin&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Movimiento lateral entre VPS&lt;/td&gt;&lt;td&gt;SG por referencia, egress restringido, IMDSv2 con hop limit 1; fase 2: TLS o WireGuard&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Acceso administrativo no autorizado&lt;/td&gt;&lt;td&gt;Sin SSH; Session Manager con SSO y MFA; auditd; pendiente: MFA en el usuario admin&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Intercepción de logs en tránsito&lt;/td&gt;&lt;td&gt;Brecha conocida: HTTP dentro de la VPC; fase 2: TLS en Loki o malla WireGuard&lt;/td&gt;&lt;td&gt;⬜ fase 2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cambio de infraestructura sin revisión&lt;/td&gt;&lt;td&gt;IaC en PR; Trivy config y Checkov fallan el CI; tofu apply manual&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Reconocimiento y escaneo de la IP pública (observado: 34 peticiones 404 a rutas .php y WordPress)&lt;/td&gt;&lt;td&gt;SG solo con el puerto 80; API sin rutas inútiles; panel de errores 4xx y 5xx; fase 2: CrowdSec o WAF y HTTPS&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Fusionar un PR con checks fallidos&lt;/td&gt;&lt;td&gt;Hoy el CI detecta pero no impide el merge: falta activar la protección de rama de main&lt;/td&gt;&lt;td&gt;🔴 pendiente&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;i&gt;Los controles de CI detectan, pero sin protección de rama no impiden el merge. T4 y T6 dependen de retirar la llave estática del usuario admin (ver hoja de ruta).&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="820" height="760" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page10" name="R · Hoja de ruta de seguridad">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="R · Estado actual y hoja de ruta de seguridad" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#232F3E;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="sub" value="ESTADO · ¿Qué ya está hecho, qué falta y en qué orden conviene cerrarlo?" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1660" height="30" as="geometry"/></mxCell>
        <mxCell id="done" value="&lt;b&gt;✅ Ya implementado y verificado en AWS real:&lt;/b&gt; infraestructura como código · acceso por SSM y SSO sin SSH · hardening del host (Lynis 69/100) · pipeline con 4 puertas, SBOM e imagen firmada · despliegue por OIDC · detección con Falco · logs en Loki · dashboard de seguridad · un escaneo real de Internet detectado a las pocas horas." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1640" height="70" as="geometry"/></mxCell>
        <mxCell id="tbl" value="&lt;table border='1' cellpadding='7' style='border-collapse:collapse;width:100%;font-size:14px'&gt;&lt;tr style='background:#EEF1F5'&gt;&lt;th&gt;Prioridad&lt;/th&gt;&lt;th&gt;Brecha&lt;/th&gt;&lt;th&gt;Riesgo&lt;/th&gt;&lt;th&gt;Siguiente paso&lt;/th&gt;&lt;th&gt;Esfuerzo&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;🔴 Alta&lt;/td&gt;&lt;td&gt;main sin protección de rama&lt;/td&gt;&lt;td&gt;Un PR con checks fallidos se puede fusionar&lt;/td&gt;&lt;td&gt;Exigir PR y los checks del CI; bloquear force-push&lt;/td&gt;&lt;td&gt;Bajo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;🔴 Alta&lt;/td&gt;&lt;td&gt;Usuario IAM admin con llave estática y sin MFA&lt;/td&gt;&lt;td&gt;Credencial de larga duración con permisos totales&lt;/td&gt;&lt;td&gt;Desactivar la llave, activar MFA o eliminar el usuario; usar solo SSO&lt;/td&gt;&lt;td&gt;Bajo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td nowrap&gt;🟡 Media&lt;/td&gt;&lt;td&gt;IP real del cliente y logs de Caddy ausentes&lt;/td&gt;&lt;td&gt;No se puede rastrear ni bloquear al atacante&lt;/td&gt;&lt;td&gt;Alloy en el gateway y pasar X-Forwarded-For con --proxy-headers en uvicorn&lt;/td&gt;&lt;td&gt;Medio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td nowrap&gt;🟡 Media&lt;/td&gt;&lt;td&gt;Escaneos de Internet en el puerto 80&lt;/td&gt;&lt;td&gt;Reconocimiento previo a un ataque dirigido&lt;/td&gt;&lt;td&gt;CrowdSec o WAF y HTTPS con dominio propio&lt;/td&gt;&lt;td&gt;Medio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td nowrap&gt;🟡 Media&lt;/td&gt;&lt;td&gt;Logs entre app y ops en HTTP plano&lt;/td&gt;&lt;td&gt;Intercepción dentro de la VPC&lt;/td&gt;&lt;td&gt;TLS en Loki o malla WireGuard entre las VPS&lt;/td&gt;&lt;td&gt;Medio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td nowrap&gt;🟡 Media&lt;/td&gt;&lt;td&gt;Humano con AdministratorAccess&lt;/td&gt;&lt;td&gt;Un error o una cuenta robada afecta a toda la cuenta&lt;/td&gt;&lt;td&gt;Permission set acotado a lo que OpenTofu necesita&lt;/td&gt;&lt;td&gt;Medio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td nowrap&gt;🟡 Media&lt;/td&gt;&lt;td&gt;Secretos de aplicación sin gestor&lt;/td&gt;&lt;td&gt;Contraseñas en archivos locales&lt;/td&gt;&lt;td&gt;SOPS + age; OpenBao si crecen los equipos&lt;/td&gt;&lt;td&gt;Medio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td nowrap&gt;🟡 Media&lt;/td&gt;&lt;td&gt;Estado de OpenTofu en un archivo local&lt;/td&gt;&lt;td&gt;Pérdida o filtración del estado&lt;/td&gt;&lt;td&gt;Backend remoto en S3 cifrado y con bloqueo&lt;/td&gt;&lt;td&gt;Bajo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⬜ Baja&lt;/td&gt;&lt;td&gt;Alertas solo visuales&lt;/td&gt;&lt;td&gt;Un incidente puede pasar desapercibido&lt;/td&gt;&lt;td&gt;Grafana Alerting hacia Slack o correo; afinar reglas de Falco&lt;/td&gt;&lt;td&gt;Medio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⬜ Baja&lt;/td&gt;&lt;td&gt;Sin VPC flow logs, subred privada ni backups&lt;/td&gt;&lt;td&gt;Poca trazabilidad de red y sin recuperación&lt;/td&gt;&lt;td&gt;Flow logs, subredes privadas con endpoints, restic a S3&lt;/td&gt;&lt;td&gt;Alto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⬜ Baja&lt;/td&gt;&lt;td&gt;Sin presupuesto ni alerta de costos&lt;/td&gt;&lt;td&gt;Gasto inesperado si se olvida un destroy&lt;/td&gt;&lt;td&gt;AWS Budgets con aviso por correo&lt;/td&gt;&lt;td&gt;Bajo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="1640" height="460" as="geometry"/></mxCell>
        <mxCell id="lg0" value="━ verde: tráfico de la aplicación" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E8E3E;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg1" value="━ naranja: logs y alertas" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#ED7100;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="295" y="660" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg2" value="┅ magenta: administración por SSM" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#E7157B;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="660" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg3" value="━ azul: CI/CD y registro" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#2088FF;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="845" y="660" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg4" value="━ rojo: IAM, OIDC y bloqueos" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#DD344C;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="660" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg5" value="┅ gris: fase 2 (no implementado)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7F8C8D;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1395" y="660" width="270" height="24" as="geometry"/></mxCell>
