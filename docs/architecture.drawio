        <mxCell id="tOps" value="Salida: 443, 80 y DNS.&lt;br&gt;Grafana solo en 127.0.0.1 (túnel SSM)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="885" y="625" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="ph2" value="Fase 2: malla WireGuard entre las 3 VPS (hoy app → ops viaja en HTTP plano dentro de la VPC) y CrowdSec en gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#7F8C8D;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="255" y="745" width="890" height="45" as="geometry"/></mxCell>
        <mxCell id="tImds" value="IMDSv2 obligatorio (hop limit 1) · EBS cifrado · SG por defecto sin reglas · sin NAT: la IP pública solo sirve para alcanzar SSM y GHCR" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="835" width="1010" height="40" as="geometry"/></mxCell>
        <mxCell id="e1" value="1 · :80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=3;strokeColor=#1E8E3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="igw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
