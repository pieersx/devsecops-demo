        <mxCell id="t6" value="T6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="615" y="595" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="t7" value="T7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="tbl" value="&lt;b&gt;Amenazas, controles y dónde se implementan&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='5' style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr style='background:#EEF1F5'&gt;&lt;th&gt;ID&lt;/th&gt;&lt;th&gt;Amenaza&lt;/th&gt;&lt;th&gt;Control&lt;/th&gt;&lt;th&gt;Estado&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Explotación de la API (inyección, ejecución remota)&lt;/td&gt;&lt;td&gt;Semgrep en cada PR; contenedor sin root, read-only, cap_drop ALL; Falco en runtime&lt;/td&gt;&lt;td nowrap&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Secreto filtrado en git&lt;/td&gt;&lt;td&gt;Gitleaks en cada PR; sin llaves de AWS gracias a OIDC; SOPS u OpenBao para secretos de aplicación&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dependencia o imagen vulnerable o manipulada&lt;/td&gt;&lt;td&gt;Trivy bloquea HIGH/CRITICAL; SBOM; Cosign y verificación antes de desplegar; Dependabot&lt;/td&gt;&lt;td nowrap&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Robo de credenciales de la nube&lt;/td&gt;&lt;td&gt;OIDC con token efímero; rol limitado a ssm:SendCommand, solo desde main y por tag&lt;/td&gt;&lt;td nowrap&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Movimiento lateral entre VPS&lt;/td&gt;&lt;td&gt;SG por referencia, egress restringido, IMDSv2 con hop limit 1; fase 2: TLS o WireGuard&lt;/td&gt;&lt;td nowrap&gt;🟡 parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Acceso administrativo no autorizado&lt;/td&gt;&lt;td&gt;Sin SSH; Session Manager con IAM y MFA; sesiones auditables; auditd&lt;/td&gt;&lt;td nowrap&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Intercepción de logs en tránsito&lt;/td&gt;&lt;td&gt;Brecha conocida: HTTP dentro de la VPC; fase 2: TLS en Loki o malla WireGuard&lt;/td&gt;&lt;td nowrap&gt;🟡 fase 2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cambio de infraestructura sin revisión&lt;/td&gt;&lt;td&gt;IaC en PR; Trivy config y Checkov bloquean; tofu apply manual&lt;/td&gt;&lt;td nowrap&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="820" height="700" as="geometry"/></mxCell>
        <mxCell id="lg0" value="━ verde: tráfico de la aplicación" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E8E3E;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="270" height="24" as="geometry"/></mxCell>
        <mxCell id="lg1" value="━ naranja: logs y alertas" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#ED7100;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="295" y="860" width="270" height="24" as="geometry"/></mxCell>
