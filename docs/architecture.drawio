        <mxCell id="e7" value="túnel SSM :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E7157B;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ssm" target="graf"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="190"/><mxPoint x="1160" y="190"/></Array></mxGeometry></mxCell>
        <mxCell id="tCtl" value="&lt;b&gt;Controles del contenedor (compose)&lt;/b&gt;&lt;br&gt;• Usuario no root (uid 10001) y raíz en solo lectura con tmpfs&lt;br&gt;• cap_drop ALL y no-new-privileges&lt;br&gt;• Límites de procesos y de memoria&lt;br&gt;• Healthcheck y rotación de logs&lt;br&gt;• Imagen base parchada y escaneada con Trivy" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="520" height="190" as="geometry"/></mxCell>
        <mxCell id="tDet" value="&lt;b&gt;Qué detecta cada capa&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Falco:&lt;/b&gt; shell dentro de un contenedor, escrituras en /etc, binarios inesperados&lt;br&gt;• &lt;b&gt;auditd:&lt;/b&gt; cambios en passwd, shadow, sudoers y Docker&lt;br&gt;• &lt;b&gt;Caddy:&lt;/b&gt; logs de acceso en JSON hacia Loki&lt;br&gt;• &lt;b&gt;SG y ufw:&lt;/b&gt; bloquean el resto del tráfico" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="600" width="600" height="190" as="geometry"/></mxCell>
        <mxCell id="tGap" value="&lt;b&gt;Brecha conocida&lt;/b&gt;&lt;br&gt;Alloy → Loki viaja en HTTP plano dentro de la VPC. Alloy y Falco necesitan acceso al socket de Docker; se mitiga con permisos mínimos y, en fase 2, un proxy de socket." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1270" y="600" width="400" height="190" as="geometry"/></mxCell>
        <mxCell id="lg0" value="━ verde: tráfico de la aplicación" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1E8E3E;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="270" height="24" as="geometry"/></mxCell>
