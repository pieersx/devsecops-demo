{
	admin off
}

# Demo sin dominio: HTTP. Con dominio propio, reemplazar ":80" por "api.tudominio.com" y Caddy gestiona TLS solo.
:80 {
	reverse_proxy {{ hostvars[groups['app'][0]].private_ip_address }}:8000

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format json
	}
}
