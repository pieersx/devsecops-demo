discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Etiqueta cada flujo con el nombre del contenedor (sin la "/" inicial).
// Loki usa la etiqueta "container" para rellenar service_name.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { host = "app" }
  forward_to = [loki.write.ops.receiver]
}

loki.write "ops" {
  endpoint {
    url = "http://{{ hostvars[groups['ops'][0]].private_ip_address }}:3100/loki/api/v1/push"
  }
}
